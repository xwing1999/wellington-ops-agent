# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Simpro Wellington API
# Pull the real base URL + auth details from the "Simpro Wellington API" resource
# config inside Retool (Resources > Simpro Wellington API > Edit), since that's
# where these currently live. Simpro typically uses OAuth2 client credentials —
# check Simpro's own API docs for this Kiwiseal Wellington instance if the
# Retool resource config doesn't expose the raw values.
SIMPRO_BASE_URL=https://your-simpro-instance.simprosuite.com/api/v1.0
SIMPRO_CLIENT_ID=
SIMPRO_CLIENT_SECRET=
SIMPRO_COMPANY_ID=

# Service
PORT=3000
# Shared secret Retool must send as the x-api-key header on every request.
# Generate a long random string — don't reuse it anywhere else.
API_KEY=
